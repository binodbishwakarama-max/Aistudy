# --- Server Port ---
PORT=3000

# --- Environment ---
# Set NODE_ENV=production on Render to enforce production CORS restrictions
NODE_ENV=development

# --- AI Provider API Keys ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional model overrides (defaults are gemini-flash-latest and llama-3.3-70b-versatile)
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=llama-3.3-70b-versatile

# --- Supabase (Database & Auth Validation) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Redis Configuration (Optional — async background BullMQ queue) ---
# Example: rediss://default:your-password@your-endpoint.upstash.io:6379
# Leave blank to use synchronous AI processing with zero external dependencies.
REDIS_URL=
